{
  "name": "ttorneo",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Gestor de torneos de tenis de mesa que funciona sin conexión",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src/nucleo",
    "test:watch": "vitest src/nucleo",
    "relevo": "node servidor/relevo.mjs",
    "torneo": "npm run build:relevo && node servidor/relevo.mjs",
    "build:relevo": "tsc -b && vite build --mode relevo",
    "simulacro": "vitest run src/simulacro.test.ts",
    "paquete": "npm run build:relevo && node servidor/relevo.mjs --empaquetar entrega/TTorneo.zip",
    "test:todo": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
